# Connection the API uses: a login role that is a member of ledger_app (not the table owner).
DATABASE_URL=postgres://ledger_api:change-me@localhost:5432/ledgerproof
# Owner connection, used only by migrations and the admin CLI.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerproof
PORT=3000
# Optional: enables POST /v1/assistant/answers. Without it the endpoint answers 503.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
