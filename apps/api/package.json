{
  "name": "@ledgerproof/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "test": "vitest run",
    "dev-db": "tsx scripts/dev-db.ts",
    "mutation-check": "tsx scripts/mutation-check.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
